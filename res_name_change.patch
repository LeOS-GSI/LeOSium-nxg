Subsystem: com.intellij.openapi.diff.impl.patch.CharsetEP
<+>UTF-8
===================================================================
diff --git a/app/src/main/res/values-fr/strings.xml b/app/src/main/res/values-fr/strings.xml
--- a/app/src/main/res/values-fr/strings.xml	(revision 6716fa30a615fd18ea62115c7a5cca2e2650cf70)
+++ b/app/src/main/res/values-fr/strings.xml	(revision f319b5d1765bdb66f259f1c74cf5307a0e2c04a8)
@@ -187,6 +187,6 @@
   <string name="custom_search_engine_error">L\'URL ne contient pas \'{searchTerms}\'</string>
   <string name="clear">Effacer</string>
   <string name="show_site_icons">Afficher les icônes des sites web?</string>
-  <string name="allow_shortcut_favicons_prompt">SmartCookieWeb Preview peut maintenant afficher les icônes des sites dont vous avez des raccourcis sur la page d\'accueil. Cependant, cette fonctionnalité nécessite que l\'application envoie les URL de vos raccourcis à un service externe (par1.cookiejarapps.com/favicon/). Aucun journal n\'est conservé à propos des sites envoyés au service. Souhaitez-vous activer cette fonctionnalité ?</string>
+  <string name="allow_shortcut_favicons_prompt">LeOSium-nxg peut maintenant afficher les icônes des sites dont vous avez des raccourcis sur la page d\'accueil. Cependant, cette fonctionnalité nécessite que l\'application envoie les URL de vos raccourcis à un service externe (par1.cookiejarapps.com/favicon/). Aucun journal n\'est conservé à propos des sites envoyés au service. Souhaitez-vous activer cette fonctionnalité ?</string>
   <string name="save_as_pdf">Enregistrer en PDF</string>
 </resources>
